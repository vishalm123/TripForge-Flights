# Copy to .env and fill in. Never commit .env.

# --- Local dev Postgres (docker-compose.dev.yml) ---
POSTGRES_USER=flights_svc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tripforge_flights
# Host port. 5433 avoids clashing with a natively installed Postgres on 5432.
POSTGRES_HOST_PORT=5433

# --- API (used by the Fastify service) ---
# From the host:
DATABASE_URL=postgres://flights_svc:change-me@localhost:5433/tripforge_flights
PORT=3001
LOG_LEVEL=info
# Fail DB statements that run longer than this (milliseconds).
DB_STATEMENT_TIMEOUT_MS=5000
